{
  "name": "blog-web-frontend",
  "version": "0.1.0",
  "homepage": "./install",
  "private": true,
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/icons": "6.3.2",
    "@zrlog/ui": "0.2.0",
    "@zrlog/utils": "0.2.0",
    "antd": "6.4.3",
    "axios": "1.20.0",
    "dompurify": "3.4.16",
    "marked": "18.0.7",
